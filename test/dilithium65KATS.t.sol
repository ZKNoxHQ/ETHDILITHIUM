    function _signature() internal pure returns (bytes memory) {
        // sm = signature (3309 bytes) || message
        return hex"";
    }

    function _message() internal pure returns (bytes memory) {
        // mlen = 33
        return hex"d81c4d8d734fcbfbeade3d3f8a039faa2a2c9957e835ad55b22e75bf57bb556ac8";
    }

    function testVerify() public {
        bytes memory pk = _pubKey();
        bytes memory sig = _signature();
        bytes memory msgs = _message();

        uint256 gasStart = gasleft();
        bool ver = dilithium.verify(pk, msgs, sig, "");
        uint256 gasUsed = gasStart - gasleft();
        console.log("Gas used:", gasUsed);
        assertTrue(ver);
    }

    /// one corrupted byte in each of the three fields of the signature, and a
    /// corrupted message: all rejected
    function testRejects() public {
        bytes memory pk = _pubKey();
        bytes memory msgs = _message();
        uint256[3] memory positions = [uint256(5), 1000, 3300]; // c~, z, h
        for (uint256 i = 0; i < 3; i++) {
            bytes memory sig = _signature();
            sig[positions[i]] ^= 0x01;
            assertFalse(dilithium.verify(pk, msgs, sig, ""));
        }
        bytes memory badMsg = _message();
        badMsg[0] ^= 0x01;
        assertFalse(dilithium.verify(pk, badMsg, _signature(), ""));
        // a context changes M': the signature was made with an empty context
        assertFalse(dilithium.verify(pk, msgs, _signature(), hex"00"));
    }
